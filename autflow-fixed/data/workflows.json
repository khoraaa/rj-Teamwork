  "wf_login_001": {
    "id": "wf_login_001",
    "name": "支付对账中台 · 任务编排",
    "requirement": "做支付渠道的 T+1 对账：拉流水、比对差异、差错工单与人工核销",
    "versions": [
      {
        "version": "v1",
        "created_at": "2026-11-11T21:10:16",
        "note": "初始版本",
        "definition": {
          "workflow_id": "wf_login_001",
          "name": "登录功能开发工作流",
          "version": "v1",
          "description": "需求 → 设计 → 并行实现/扫描 → 质量门判定 → 分支 → 汇聚 → 人工审批 → 交付",
          "requirement": "为系统实现用户名密码登录：支持记住登录态、失败重试锁定、登录日志审计",
          "concurrency_limit": 3,
          "nodes": [
            {
              "id": "N1",
              "type": "start",
              "name": "需求输入",
              "role": "system",
              "deps": []
            },
            {
              "id": "N2",
              "type": "agent",
              "name": "接口与数据模型设计",
              "role": "architect",
              "deps": [
                "N1"
              ],
              "out_schema": "design-v1",
              "max_retries": 2,
              "timeout": 300
            },
            {
              "id": "N3",
              "type": "agent",
              "name": "登录接口实现",
              "role": "coder",
              "deps": [
                "N2"
              ],
              "out_schema": "code-result-v1",
              "max_retries": 3,
              "timeout": 600
            },
            {
              "id": "N4",
              "type": "agent",
              "name": "安全基线扫描",
              "role": "qa",
              "deps": [
                "N2"
              ],
              "out_schema": "scan-v1",
              "max_retries": 2,
              "timeout": 300
            },
            {
              "id": "N5",
              "type": "condition",
              "name": "质量门判定",
              "role": "qa",
              "deps": [
                "N3",
                "N4"
              ],
              "expression": "qa_score >= 80",
              "max_retries": 0
            },
            {
              "id": "N6",
              "type": "agent",
              "name": "回归测试",
              "role": "qa",
              "deps": [
                "N5"
              ],
              "branch": "true",
              "out_schema": "test-v1",
              "max_retries": 2
            },
            {
              "id": "N7",
              "type": "agent",
              "name": "按评审意见重构",
              "role": "coder",
              "deps": [
                "N5"
              ],
              "branch": "false",
              "out_schema": "code-result-v1",
              "max_retries": 2
            },
            {
              "id": "N8",
              "type": "agent",
              "name": "合并验证",
              "role": "qa",
              "deps": [
                "N6",
                "N7"
              ],
              "join": "any",
              "out_schema": "verify-v1",
              "max_retries": 2
            },
            {
              "id": "N9",
              "type": "approval",
              "name": "上线审批",
              "role": "human",
              "deps": [
                "N8"
              ],
              "risk": "high"
            },
            {
              "id": "N10",
              "type": "end",
              "name": "交付完成",
              "role": "system",
              "deps": [
                "N9"
              ]
            }
          ],
