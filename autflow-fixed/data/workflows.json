        "description": "做一个图文内容社区：能发笔记、看推荐流、点赞评论关注、内容合规审核",
        "requirement": "做一个图文内容社区：能发笔记、看推荐流、点赞评论关注、内容合规审核",
        "spec_id": "SP2",
        "spec_revision": 1,
        "spec_hash": "0cb844dd70ebd3811387bd8f2246386b3fa1d1da6d47612f1b946d076f2f1dee",
        "spec_snapshot": {
          "id": "SP2",
          "name": "社区内容平台（小红书式）",
          "summary": "做一个图文内容社区：能发笔记、看推荐流、点赞评论关注、内容合规审核",
          "body": "目标：面向年轻用户的内容社区 MVP。\n核心链路：发布笔记 → 进入推荐池 → 首页信息流分发 → 互动（点赞/评论/关注）→ 站内通知。\n红线：所有公开内容必须先过审核，违规内容不得进入推荐池；审核动作必须留痕可追溯。",
          "modules": [
            {
              "id": "M1",
              "name": "账号与内容发布",
              "goal": "登录后发布图文笔记，支持草稿与定时发布",
              "priority": "P0",
              "acceptance": [
                "支持图文草稿保存与恢复",
                "发布成功后 3 秒内可被检索到",
                "违规内容在发布环节即被拦截"
              ]
            },
            {
              "id": "M2",
              "name": "信息流推荐",
              "goal": "首页推荐流，按兴趣与热度混排",
              "priority": "P0",
              "acceptance": [
                "首屏渲染 < 800ms",
                "支持下拉刷新与无限滚动",
                "同一用户 10 分钟内不重复推荐同一条"
              ]
            },
            {
              "id": "M3",
              "name": "互动与通知",
              "goal": "点赞、评论、关注，以及对应的站内通知",
              "priority": "P1",
              "acceptance": [
                "互动后 1 秒内产生通知",
                "通知列表区分已读未读",
                "取关后不再收到该用户通知"
              ]
            },
            {
              "id": "M4",
              "name": "内容审核与风控",
              "goal": "文本敏感词与图片机审，命中转人工复核队列",
              "priority": "P0",
              "acceptance": [
                "敏感词命中率 ≥ 95%",
                "人工复核队列支持指派与结论回写",
                "每次审核动作写入审计日志"
              ]
            }
          ],
          "constraints": [
            "内容合规须满足《网络信息内容生态治理规定》",
            "灰度发布，支持按用户分桶与一键回滚"
          ],
          "created_at": "2026-11-15T18:37:45",
          "updated_at": "2026-11-15T19:05:54",
          "revision": 1,
