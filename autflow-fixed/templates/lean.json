{
  "id": "lean",
  "name": "敏捷精简流程",
  "description": "需求梳理 → 按能力域并行实现（最多 2 路）→ 集成自测 → 上线确认 → 完成；无质量门分支、无安全评审，适合小步快跑的验证型需求",
  "concurrency_limit": 2,
  "domains": [
    {"label": "认证与账号", "role": "coder",
     "keywords": ["登录", "注册", "账号", "密码", "认证", "鉴权", "验证码", "单点"]},
    {"label": "交易与支付", "role": "coder",
     "keywords": ["支付", "订单", "结算", "退款", "购物车", "交易", "对账"]},
    {"label": "检索与列表", "role": "coder",
     "keywords": ["搜索", "检索", "查询", "列表", "分页", "筛选", "排序"]},
    {"label": "数据与报表", "role": "coder",
     "keywords": ["报表", "统计", "看板", "分析", "大盘", "导出"]},
    {"label": "通知与消息", "role": "coder",
     "keywords": ["通知", "消息", "推送", "邮件", "站内信", "订阅"]},
    {"label": "文件与存储", "role": "coder",
     "keywords": ["文件", "上传", "附件", "图片", "存储", "下载"]}
  ],
  "risk_words": ["支付", "资金", "退款"],
  "pipeline": [
    {"kind": "start", "name": "需求输入", "role": "system", "max_retries": 0},
    {"kind": "agent", "name": "需求梳理与任务拆解", "role": "pm", "out_schema": "prd-v1"},
    {"kind": "fanout", "source": "domains", "max": 2, "suffix": "",
     "role": "coder", "out_schema": "code-result-v1", "max_retries": 2,
     "fallback": {"name": "核心功能实现", "role": "coder"}},
    {"kind": "join", "name": "集成自测", "role": "qa", "join": "any", "out_schema": "verify-v1"},
    {"kind": "approval", "name": "上线确认", "role": "human", "max_retries": 0},
    {"kind": "end", "name": "完成", "role": "system", "max_retries": 0}
  ]
}